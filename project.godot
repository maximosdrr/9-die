[network]

transport="enet"
max_players=4
max_channels=5
port=7777
default_host_address="127.0.0.1"
game_id="9die"
protocol_version="1"
session_attempt_timeout_seconds=15.0

[physics]

common/physics_jitter_fix=1.0
3d/solver/solver_iterations=24
common/physics_interpolation=true

[rendering]

textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=2
textures/default_filters/texture_mipmap_bias=-0.25

[steam]

initialization/app_id=480
initialization/embed_callbacks=false
initialization/initialize_on_startup=false
multiplayer_peer/max_channels=5
