<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release'
      Or '$(Configuration)' == 'ExportDebug'
      Or '$(Configuration)' == 'ExportRelease'">
    <!-- Godot publishes with ExportDebug/ExportRelease, not Debug/Release. Test scenes are not
         exported, so their harness code must not ship in any distributable game assembly. -->
    <Compile Remove="**/Tests/**/*.cs" />
  </ItemGroup>
</Project>
