[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_buttons"]

[node name="BrowseScreen" type="Control"]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
